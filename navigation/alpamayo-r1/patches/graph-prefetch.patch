+def cholesky_solve_torch(lhs: torch.Tensor, rhs: torch.Tensor) -> torch.Tensor:
+    """纯 torch 批量 Cholesky 求解（lhs 为 (..., N, N) 对称正定，rhs 为 (..., N)）。
+
+    NPU 上 torch.linalg.cholesky 与 torch.cholesky_solve 会回退到 CPU，每次调用都带来
+    主机与设备之间的同步。这里用逐列向量算子实现同一算法：Cholesky 分解之后做一遍
+    前代、一遍回代，全部算子在 NPU 上执行。
+    """
+    from ..flags import legacy_ops
+
+    if legacy_ops():
+        factor = torch.linalg.cholesky(lhs)
+        return torch.cholesky_solve(rhs.unsqueeze(-1), factor).squeeze(-1)
+
+    n = lhs.size(-1)
+    factor = torch.zeros_like(lhs)
+    for i in range(n):
+        diagonal = lhs[..., i, i] - (factor[..., i, :i] * factor[..., i, :i]).sum(-1)
+        factor[..., i, i] = torch.sqrt(torch.clamp(diagonal, min=1e-12))
+        if i + 1 < n:
+            column = lhs[..., i + 1:, i] - (
+                factor[..., i + 1:, :i] * factor[..., i, :i].unsqueeze(-2)
+            ).sum(-1)
+            factor[..., i + 1:, i] = column / factor[..., i, i].unsqueeze(-1)
+    y = torch.zeros_like(rhs)
+    for i in range(n):
+        if i == 0:
+            y[..., i] = rhs[..., i] / factor[..., i, i]
+        else:
+            y[..., i] = (
+                rhs[..., i] - (factor[..., i, :i] * y[..., :i]).sum(-1)
+            ) / factor[..., i, i]
+    x = torch.zeros_like(rhs)
+    for i in range(n - 1, -1, -1):
+        if i == n - 1:
+            x[..., i] = y[..., i] / factor[..., i, i]
+        else:
+            x[..., i] = (
+                y[..., i] - (factor[..., i + 1:, i] * x[..., i + 1:]).sum(-1)
+            ) / factor[..., i, i]
+    return x
