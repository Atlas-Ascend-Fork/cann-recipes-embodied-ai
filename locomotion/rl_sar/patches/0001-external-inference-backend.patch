+void ApplyInferenceResult(RL& rl, const InferenceResult& result)
+{
+    if (result.actions.size() != static_cast<size_t>(rl.params.num_of_dofs) ||
+        result.ref_joint_pos.size() != static_cast<size_t>(rl.params.num_of_dofs) ||
+        result.ref_joint_vel.size() != static_cast<size_t>(rl.params.num_of_dofs) ||
+        result.ref_body_quat.size() != 4)
+    {
+        throw std::runtime_error("External inference backend returned invalid output shapes");
+    }
+
+    const auto finite = [](const std::vector<float>& values) {
+        return std::all_of(values.begin(), values.end(), [](float value) { return std::isfinite(value); });
+    };
+    if (!finite(result.actions) || !finite(result.ref_joint_pos) ||
+        !finite(result.ref_joint_vel) || !finite(result.ref_body_quat))
+    {
+        throw std::runtime_error("External inference backend returned non-finite output");
+    }
+
+    rl.ref_joint_pos = rl.VectorToTensor(result.ref_joint_pos, {1, rl.params.num_of_dofs});
+    rl.ref_joint_vel = rl.VectorToTensor(result.ref_joint_vel, {1, rl.params.num_of_dofs});
+    rl.ref_body_quat_w = rl.VectorToTensor(result.ref_body_quat, {1, 4});
+}
+}
+
+bool RL::InitExternalBackend(const std::string& model_path)
+{
+    const PolicyDimensions policy{
+        static_cast<size_t>(this->params.num_observations),
+        static_cast<size_t>(this->params.num_of_dofs)};
+    this->external_backend = CreateExternalInferenceBackend(model_path, policy);
+    if (!this->external_backend)
+    {
+        return false;
+    }
+
+    this->external_backend->LoadModel(model_path);
+    ApplyInferenceResult(*this, this->external_backend->Forward(this->ComputeObservationFloat(), 0.0f));
+    return true;
+}
+
+bool RL::HasExternalBackend() const
+{
+    return this->external_backend && this->external_backend->IsModelLoaded();
+}
+
+torch::Tensor RL::ForwardExternalBackend()
+{
+    InferenceResult result = this->external_backend->Forward(
+        this->ComputeObservationFloat(), static_cast<float>(this->episode_length_buf));
+    ApplyInferenceResult(*this, result);
+
+    torch::Tensor actions = this->VectorToTensor(result.actions, {1, this->params.num_of_dofs});
+    if (this->params.clip_actions_upper.numel() != 0 && this->params.clip_actions_lower.numel() != 0)
+    {
+        return torch::clamp(actions, this->params.clip_actions_lower, this->params.clip_actions_upper);
+    }
+    return actions;
+}
